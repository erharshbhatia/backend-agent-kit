# Copy to .env (git-ignored) and fill in. app/settings.py loads .env automatically.
# Never commit .env. Never put real secrets in this file.

# Postgres (docker compose publishes it on host port APP_PG_HOST_PORT, default 55432; pick another
# when a second project on this machine already holds it, and change the URL to match).
APP_DB__URL=postgresql+psycopg://app:app@localhost:55432/app
# APP_PG_HOST_PORT=55432
# APP_API_HOST_PORT=8080
# Pool per process: POOL_SIZE + MAX_OVERFLOW. Keep processes x (pool + overflow) under
# Postgres max_connections (100 default, 3 reserved).
# APP_DB__POOL_SIZE=5
# APP_DB__MAX_OVERFLOW=5

# Logging: console | json; DEBUG | INFO | WARNING | ERROR.
APP_LOGGING__FORMAT=console
APP_LOGGING__LEVEL=INFO

# Worker
# APP_WORKER__POLL_INTERVAL_S=1.0

# External service keys go here, empty, with a comment naming the ADR that requires them.
